# SideNote Frontend – Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# Backend API URL (no trailing slash)
# Dev defaults: http://localhost:3000 (iOS/web) or http://10.0.2.2:3000 (Android emulator)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Supabase project URL and public anon key (safe to expose in frontend)
# Find these in: Supabase dashboard > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key_here

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id

# RevenueCat Public SDK Keys (safe for client-side use)
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=goog_your_public_key_here
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=appl_your_public_key_here